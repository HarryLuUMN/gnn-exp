{
  "scripts": {
    "build": "esbuild js/*/index.tsx --bundle --format=esm --minify --sourcemap --outdir=src/gnn_exp/static --outbase=js",
    "build:playwright-fixtures": "PYTHONPATH=src python3 tests/playwright/generate_gnn_layer_fixtures.py",
    "build:playwright-harness": "esbuild tests/playwright/gnn-layer-harness.tsx tests/playwright/graph-editor-harness.tsx --bundle --format=esm --sourcemap --outdir=tests/playwright/.cache",
    "dev": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test:playwright": "npm run build && npm run build:playwright-fixtures && npm run build:playwright-harness && playwright test"
  },
  "dependencies": {
    "@anywidget/react": "^0.2.0",
    "d3": "^7.9.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.4",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3"
  }
}
